<% content_for(:title, "results · findMe") %>
<canvas class="sky" data-controller="sky" aria-hidden="true"></canvas>
<main class="hunt">
  <header>
    <h1>results</h1>
    <p>Hunts with a pin. Median distance to the pin, to 10 m. "Ours": final guess. "IP": network location alone.</p>
  </header>

  <% if @total.zero? %>
    <p class="muted">No results yet.</p>
  <% else %>
    <% row = ->(label, s) { s ? format("%-26s %6d %10s %10s %9s %9s", label, s[:count], distance(s[:median_m]), distance(s[:ip_median_m]), percent(s[:within_1km], s[:count]), percent(s[:audio_won], s[:count])) : format("%-26s %6d", label, 0) } %>
    <pre class="table"><%= format("%-26s %6s %10s %10s %9s %9s", "guess rested on", "hunts", "ours", "IP", "<= 1 km", "beat IP") %>
<%= "-" * 75 %>
<%= row.("planes (Doppler)", @tiers["doppler"]) %>
<%= row.("mains hum + IP", @tiers["mains"]) %>
<%= row.("IP only", @tiers["ip"]) %>
<%= "-" * 75 %>
<%= row.("all", @all) %></pre>
  <% end %>

  <p><a href="<%= root_path %>">&larr; find me</a></p>
</main>
