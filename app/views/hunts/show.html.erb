<% content_for(:title, "find me by ear") %>
<canvas class="sky" data-controller="sky" aria-hidden="true"></canvas>
<main class="hunt" data-controller="hunt" data-hunt-url-value="<%= hunt_path %>">
  <section class="intro" data-hunt-target="intro">
    <div class="globe" data-controller="globe" aria-hidden="true"><canvas data-globe-target="screen"></canvas><canvas class="planes" data-globe-target="planes"></canvas></div>
    <div class="controls">
      <input type="range" min="1" max="15" value="3" aria-label="listen for up to"
        data-hunt-target="cap" data-action="input->hunt#capChanged">
      <output data-hunt-target="capLabel">3 min</output>
      <button type="button" data-hunt-target="start" data-action="hunt#start">find me</button>
    </div>
  </section>

  <p class="error" data-hunt-target="error" hidden></p>

  <section class="live" data-hunt-target="live" hidden>
    <p class="status"><span data-hunt-target="status"></span> <span class="muted" data-hunt-target="clock"></span></p>
    <div class="panels">
      <figure class="spectrogram">
        <canvas data-hunt-target="spectrogram"></canvas>
        <canvas class="overlay" data-hunt-target="overlay"></canvas>
      </figure>
      <div class="map" data-hunt-target="map"></div>
    </div>
    <div class="controls">
      <button type="button" data-hunt-target="stop" data-action="hunt#stop">stop and guess</button>
      <button type="button" data-hunt-target="testFlight" data-action="hunt#testFlight" hidden>play a test flight</button>
    </div>
    <pre data-hunt-target="aircraft"></pre>
    <pre class="muted small" data-hunt-target="mic"></pre>

    <section class="reveal" data-hunt-target="reveal" hidden>
      <h2>guess</h2>
      <p data-hunt-target="verdict"></p>
      <div data-hunt-target="pinPrompt">
        <p>Click your real location, then send. Only the two distances are stored.</p>
        <div class="controls">
          <button type="button" data-hunt-target="submitPin" data-action="hunt#submitPin" disabled>send</button>
          <button type="button" data-action="hunt#skip">skip</button>
        </div>
      </div>
      <div data-hunt-target="score" hidden>
        <pre></pre>
        <p><a href="<%= root_path %>">again</a> · <a href="<%= results_path %>">all results</a></p>
      </div>
    </section>
  </section>

</main>
<footer data-controller="footnote" data-action="click@window->footnote#outside keydown.esc@window->footnote#close">
  <%# On the intro this is plain small print. Once a hunt is live it folds into a button that pops it up. %>
  <button type="button" class="footnote-toggle" aria-expanded="false" aria-controls="footnote"
    data-footnote-target="toggle" data-action="footnote#toggle">credits &uarr;</button>
  <div class="footnote-body" id="footnote">
  Method by <a href="https://www.youtube.com/watch?v=UytYrhYLOKI">colsto</a>; solver after
  <a href="https://github.com/Bodila51/colsto-leak-and-mask">colsto-leak-and-mask</a>. Flight data
  <a href="https://www.adsb.lol/">adsb.lol</a> (ODbL), elevation Copernicus DEM GLO-90, map &copy; OpenStreetMap
  contributors, <a href="https://db-ip.com">IP Geolocation by DB-IP</a>. Odds: this method mostly missed in public blind tests. <a href="<%= results_path %>">Results</a>.
  </div>
</footer>
